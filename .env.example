# Server runtime secrets ONLY. Leave public config.js free of credentials.
MFTBOOST_API_KEY=
# Set to agent only after confirming this key belongs to YOUR Agent account.
# The documented API does not return an account-tier claim.
MFTBOOST_ACCOUNT_TIER=
# Generate an independent owner token with: openssl rand -hex 32
# Never use your provider key as the admin token.
VEZLIO_ADMIN_TOKEN=
# Persistent private directory, outside any static web root.
VEZLIO_DATA_DIR=./private-data
HOST=127.0.0.1
PORT=8000
# Required HTTPS origin when NODE_ENV=production; no trailing slash.
PUBLIC_ORIGIN=
