# Server runtime only. Set these in Netlify's Functions scope after approval.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact UUID from Supabase Authentication > Users; also set it in private DB config.
SUPABASE_OWNER_UUID=
# One exact canonical origin, with no trailing slash. Use HTTPS when hosted.
SITE_ORIGIN=http://localhost:8888
# Local development only; never set this in Netlify.
VEZLIO_LOCAL_DEV=1
# Hosted builds fail closed until the owner explicitly approves publication.
# Set to approved in Netlify's Builds scope ONLY after explicit approval.
VEZLIO_ALLOW_NETLIFY_DEPLOY=
# No service-role key, DB password, payment secret or frontend VITE_/PUBLIC_ secret.
